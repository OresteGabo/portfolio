<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/next_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_price_notification" android:contentDescription="@string/app_name" />
        <TextView android:id="@+id/next_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/next_widget_heading" android:textColor="#F2E6A7" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/next_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B9C4AD" android:textSize="9sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp">
        <LinearLayout android:id="@+id/next_primary" android:layout_width="0dp" android:layout_weight="1.6" android:layout_height="match_parent" android:orientation="vertical">
            <TextView android:id="@+id/next_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/next_widget_preview_status" android:textColor="#B9C4AD" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/next_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/next_widget_preview_title" android:textColor="#F7F5E9" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/next_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/next_widget_preview_date" android:textColor="#F2E6A7" android:textSize="26sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/next_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/next_widget_preview_detail" android:textColor="#B9C4AD" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/next_secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="14dp" android:layout_marginStart="12dp">
            <TextView android:id="@+id/next_second_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/next_widget_after" android:textColor="#B9C4AD" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/next_second_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/next_widget_preview_second" android:textColor="#F7F5E9" android:textSize="13sp" android:maxLines="3" android:ellipsize="end" />
            <TextView android:id="@+id/next_second_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/next_widget_preview_date" android:textColor="#F2E6A7" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/next_second_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#B9C4AD" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
