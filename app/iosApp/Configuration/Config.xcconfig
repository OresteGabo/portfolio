TEAM_ID=

PRODUCT_NAME=Portfolio
PRODUCT_BUNDLE_IDENTIFIER=dev.orestegabo.portfolio.Portfolio

#include "../../../Version.xcconfig"

// Empty by default; an explicit Debug build may override this from xcodebuild.
GABO_DEVELOPMENT_API_ORIGIN =

// Enable only with an Associated Domains-capable Apple Developer profile.
GABO_PASSWORD_SHARING_ENABLED = NO
GABO_PASSWORD_ENTITLEMENTS_NO =
GABO_PASSWORD_ENTITLEMENTS_YES = iosApp/Portfolio.entitlements

// Requires a paid Apple Developer profile with Push Notifications enabled.
GABO_PUSH_ENABLED = NO
GABO_APNS_ENVIRONMENT = development
GABO_PUSH_ENVIRONMENT = sandbox
GABO_PUSH_ENTITLEMENTS_NO = $(GABO_PASSWORD_ENTITLEMENTS_$(GABO_PASSWORD_SHARING_ENABLED))
GABO_PUSH_ENTITLEMENTS_YES = iosApp/Push.entitlements
