TEAM_ID=

PRODUCT_NAME=Portfolio
PRODUCT_BUNDLE_IDENTIFIER=dev.orestegabo.portfolio.Portfolio

// Both IDEs use the framework prepared by build-ios-framework.sh, including
// recovery after a clean removes Android Studio's previously generated framework.
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../shared/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)"

#include "../../../Version.xcconfig"

// Empty by default; an explicit Debug build may override this from xcodebuild.
GABO_DEVELOPMENT_API_ORIGIN =

// Enable only with an Associated Domains-capable Apple Developer profile.
GABO_PASSWORD_SHARING_ENABLED = NO
GABO_PASSWORD_ENTITLEMENTS_NO =
GABO_PASSWORD_ENTITLEMENTS_YES = iosApp/Portfolio.entitlements

// Requires a paid Apple Developer profile with Push Notifications enabled.
GABO_PUSH_ENABLED = NO
GABO_APNS_ENVIRONMENT = development
GABO_PUSH_ENVIRONMENT = sandbox
GABO_PUSH_ENTITLEMENTS_NO = $(GABO_PASSWORD_ENTITLEMENTS_$(GABO_PASSWORD_SHARING_ENABLED))
GABO_PUSH_ENTITLEMENTS_YES = iosApp/Push.entitlements

// Local WidgetKit sharing; independent of APNs/push membership.
GABO_WIDGETS_ENABLED = YES
GABO_WIDGET_APP_GROUP = group.dev.orestegabo.portfolio.whatsnext
GABO_WIDGET_BASE_ENTITLEMENTS_NO = iosApp/Widgets.entitlements
GABO_WIDGET_BASE_ENTITLEMENTS_YES = iosApp/WidgetsPassword.entitlements
GABO_WIDGET_PUSH_ENTITLEMENTS_NO = $(GABO_WIDGET_BASE_ENTITLEMENTS_$(GABO_PASSWORD_SHARING_ENABLED))
GABO_WIDGET_PUSH_ENTITLEMENTS_YES = iosApp/WidgetsPush.entitlements
GABO_APP_ENTITLEMENTS_NO = $(GABO_PUSH_ENTITLEMENTS_$(GABO_PUSH_ENABLED))
GABO_APP_ENTITLEMENTS_YES = $(GABO_WIDGET_PUSH_ENTITLEMENTS_$(GABO_PUSH_ENABLED))
