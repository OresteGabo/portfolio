<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleDocumentTypes</key>
    <array><dict>
        <key>CFBundleTypeName</key><string>Investment PDF</string>
        <key>CFBundleTypeRole</key><string>Viewer</string>
        <key>LSHandlerRank</key><string>Alternate</string>
        <key>LSItemContentTypes</key><array><string>com.adobe.pdf</string></array>
    </dict></array>
    <key>LSSupportsOpeningDocumentsInPlace</key><false/>
    <key>CFBundleDisplayName</key>
    <string>Struct Capital</string>
	<key>GaboDevelopmentApiOrigin</key>
	<string>$(GABO_DEVELOPMENT_API_ORIGIN)</string>
	<key>NSMotionUsageDescription</key>
	<string>Detect a shake to hide or show financial amounts.</string>
    <key>GaboPasswordSharingEnabled</key>
    <string>$(GABO_PASSWORD_SHARING_ENABLED)</string>
    <key>GaboPushEnabled</key>
    <string>$(GABO_PUSH_ENABLED)</string>
    <key>GaboPushEnvironment</key>
    <string>$(GABO_PUSH_ENVIRONMENT)</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Use Face ID to unlock your securely saved portfolio sign-in.</string>
	<key>NSAppTransportSecurity</key>
    <dict><key>NSAllowsLocalNetworking</key><true/></dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Connect to your investment server when it is hosted on your local network.</string>
    <key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
</dict>
</plist>
