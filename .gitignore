*~

# Local UI verification captures, separate from the app's icons and image assets.
# Existing tracked screenshots remain versioned; new captures stay local.
/docs/screenshots/

# Local legal-document exports regenerated by scripts/generate_legal.py.
# Keep docs/legal/content.json, its README, the generator and generated Kotlin:
# Gradle compiles that Kotlin file directly and does not run the generator.
/docs/legal/*.en.md
/docs/legal/*.fr.md

# macOS metadata
.DS_Store
._*

# Keep scripts, tests and their synthetic fixtures regardless of extension.
# Do not ignore *.js, *.mjs, *.png or *.txt globally.
# Keep bundled PDF/OCR runtime assets (bcmap, fonts, wasm, traineddata and licenses).
# They are app dependencies, not local build outputs; fresh checkouts need them.

# Local native push-provider configuration
/app/androidApp/google-services.json
**/AuthKey_*.p8
