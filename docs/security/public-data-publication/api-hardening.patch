+package dev.orestegabo.portfolio
+
+import org.springframework.jdbc.core.JdbcTemplate
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+/** Server-owned capability; invitation, consent and client role fields never grant publication. */
+@Service
+class PublicDataPublication(private val db: JdbcTemplate) {
+    fun canPublish(account: String): Boolean = account == "owner" ||
+        db.queryForObject("SELECT EXISTS(SELECT 1 FROM public_data_publishers WHERE account_id=?)",Boolean::class.java,account)==true
+    fun requirePublisher(account: String) {
+        checkApi(canPublish(account),"Only the owner or authorized Struct Capital staff can publish shared data.",403)
+    }
+    @Transactional fun setPublisher(actor: String,account: String,enabled: Boolean) {
+        checkApi(actor=="owner" && account!="owner","Only the owner can manage publication permissions.",403)
+        // Same lock as document upload: revocation and publication have a defined transaction order.
+        lockAccount(db,account)
+        if(enabled) db.update("INSERT INTO public_data_publishers(account_id,granted_by) VALUES (?,?) ON CONFLICT DO NOTHING",account,actor)
+        else db.update("DELETE FROM public_data_publishers WHERE account_id=?",account)
+        db.update("INSERT INTO public_data_permission_events(account_id,actor_id,enabled) VALUES (?,?,?)",account,actor,enabled)
+    }
+}
