+-- Named staff may publish shared reference data; this is not an owner/admin role.
+CREATE TABLE public_data_publishers (
+    account_id text PRIMARY KEY CHECK (account_id <> 'owner'),
+    granted_by text NOT NULL CHECK (granted_by = 'owner'),
+    granted_at timestamptz NOT NULL DEFAULT now()
+);
+CREATE TABLE public_data_permission_events (
+    id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+    account_id text NOT NULL,
+    actor_id text NOT NULL CHECK (actor_id = 'owner'),
+    enabled boolean NOT NULL,
+    created_at timestamptz NOT NULL DEFAULT now()
+);
+-- Preserve old files for investigation. Only server-recorded owner publications are grandfathered.
+-- A visibility flag, valid PDF format, or missing publisher is not publication authority.
+ALTER TABLE bond_issuance_documents ADD COLUMN approved boolean NOT NULL DEFAULT false;
+UPDATE bond_issuance_documents SET approved=true WHERE metadata->>'_publishedBy'='owner';
